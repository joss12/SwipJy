{
    "name": "swipjy",
    "version": "0.1.0",
    "description": "SwipJy – Lightweight Node.js framework with SSR, hydration, CLI scaffolding, and dev server",
    "type": "module",
    "main": "./lib/index.js",
    "bin": {
        "swipjy": "./bin/swipjy.js"
    },
    "exports": {
        ".": {
            "import": "./lib/index.js"
        }
    },
    "files": [
        "bin/",
        "cli/",
        "lib/",
        "templates/",
        "views/",
        "public/"
    ],
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "swipjy dev",
        "create": "swipjy create"
    },
    "keywords": [
        "framework",
        "nodejs",
        "ssr",
        "react",
        "cli",
        "hydration",
        "esbuild"
    ],
    "author": "Eddy Joss Axel Mouity",
    "license": "MIT",
    "dependencies": {
        "esbuild": "^0.21.5"
    },
    "devDependencies": {},
    "engines": {
        "node": ">=18.0.0"
    }
}
